# ===========================================
# quick_hack - Security Auditing Browser IDE
# ===========================================
# Copy this file to .env and fill in your values
# API keys can also be configured in the Settings UI

# ===================
# API Keys (Optional - can be set via Settings UI)
# ===================

# OpenAI API Key (for GPT-4o, GPT-4o-mini, o1)
OPENAI_API_KEY=

# Anthropic API Key (for Claude Opus 4.5, Sonnet, Haiku)
ANTHROPIC_API_KEY=

# Anthropic OAuth/Auth Token (for Claude Code / subscription or Teams auth)
# Prefer this over ANTHROPIC_API_KEY if your token looks like `sk-ant-oat*`.
ANTHROPIC_AUTH_TOKEN=

# ===================
# Ollama Configuration
# ===================

# Host port to expose the Docker Ollama server on.
# If you already have Ollama running locally (default port 11434), set this to a different port (e.g. 11435).
OLLAMA_HOST_PORT=11434

# Ollama base URL (default works with Docker Compose)
# Use http://localhost:11434 if running Ollama outside Docker
OLLAMA_BASE_URL=http://ollama:11434

# ===================
# Application Settings
# ===================

# Debug mode (hot reload, verbose logging)
DEBUG=true

# Maximum concurrent security agents
MAX_CONCURRENT_AGENTS=5

# Enable Docker sandbox for code execution
SANDBOX_ENABLED=true

# ===================
# Frontend Settings
# ===================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ===================
# Redis (for caching)
# ===================

REDIS_URL=redis://redis:6379

# ===================
# Database
# ===================

DATABASE_URL=postgresql+asyncpg://quickhack:quickhack_dev@localhost:5432/quickhack

# ===================
# Security (change in production!)
# ===================

SETTINGS_SECRET=change_this_in_production_use_random_string

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_64_CHAR_STRING

# Legacy auth (deprecated, will be removed in future version)
# Allow unauthenticated auth bootstrap endpoints (/api/auth/*) from non-loopback clients.
# Keep this false unless the backend is otherwise access-controlled (e.g., localhost-only bind).
AUTH_BOOTSTRAP_ALLOW_REMOTE=false

# ===================
# Protocol Layer Configuration
# ===================

# Enable protocol evaluation (true/false)
ENABLE_PROTOCOL_EVALUATION=true

# Default protocol for new projects
DEFAULT_PROTOCOL_ID=internal

# Evidence Quest Settings (also used for LLM-based filtering)
ENABLE_QUESTS_BY_DEFAULT=true
QUEST_LLM_MODEL=claude-3-5-sonnet-20241022
QUEST_TIMEOUT_SECONDS=120
QUEST_MAX_RETRIES=1
